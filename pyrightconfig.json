{
  "exclude": [
    "**/.*",
    "**/node_modules",
    "**/__pycache__",
    ".venv",
    // Ignore generated files
    "packages/metamist/src/metamist/api/**/*",
    "packages/metamist/src/metamist/apis/**/*",
    "packages/metamist/src/metamist/model/**/*",
    "packages/metamist/src/metamist/models/**/*",
    "packages/metamist/src/metamist/__init__.py",
    "packages/metamist/src/metamist/api_client.py",
    "packages/metamist/src/metamist/configuration.py",
    "packages/metamist/src/metamist/exceptions.py",
    "packages/metamist/src/metamist/model_utils.py",
    "packages/metamist/src/metamist/rest.py",
    "packages/metamist/build",
    // Ignore package build files
    "packages/metamist/build/**/*",
    "packages/metamist/dist/**/*",
    // Ignore parsers, too many errors to fix
    "packages/metamist/src/metamist/parser/*",
    // Ignore seqr project data gen too many errors
    "test/data/generate_seqr_project_data.py",
    // Ignore sample status update script, it's old and unused
    "./update_sample_status",
    // Ignore metamist_infrastructure, it is deprecated and will be removed soon
    "./metamist_infrastructure",
    // Scripts will also be removed from this repo soon
    "./scripts",
    "htmlcov",

  ],

  "typeCheckingMode": "standard",
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux",

  "reportUnnecessaryTypeIgnoreComment": "error",
  "venvPath": ".",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "packages/metamist",
      "pythonVersion": "3.10"
    },
    {
      "root": "test",
      "extraPaths": ["."]
    }
  ]
}
